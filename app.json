{
  "expo": {
    "name": "BooffIn",
    "slug": "booffin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "booffin",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "associatedDomains": [
        "applinks:letsbooffin.com",
        "applinks:www.letsbooffin.com"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "BooffIn requires camera access for private peer-to-peer encrypted video discussions.",
        "NSMicrophoneUsageDescription": "BooffIn requires microphone access for private peer-to-peer encrypted voice calls.",
        "NSPhotoLibraryUsageDescription": "BooffIn requires access to your photo library to allow you to upload scientific diagrams, research figures, and profile avatars."
      }
    },
    "android": {
      "package": "com.booffin.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.letsbooffin.com",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "letsbooffin.com",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "navigationBar": {
        "visible": "always",
        "barStyle": "dark-content",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "BooffIn",
      "shortName": "BooffIn",
      "description": "Research finds it's people. A modern academic and scientific discussion community.",
      "themeColor": "#064E3B",
      "backgroundColor": "#FFFFFF",
      "display": "standalone",
      "startUrl": "/"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "BooffIn accesses your photos to allow you to upload scientific diagrams, research figures, and profile avatars."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eada90d5-a216-4b7b-909d-dc780ce350c7"
      }
    },
    "owner": "sagaryadav_11"
  }
}
