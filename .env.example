# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Official ORCID Public API Credentials (from https://orcid.org/developer-tools)
EXPO_PUBLIC_ORCID_CLIENT_ID=APP-XXXXXXXXXXXXXXXX
EXPO_PUBLIC_ORCID_CLIENT_SECRET=your-orcid-client-secret
EXPO_PUBLIC_ORCID_REDIRECT_URI=https://booff-in.vercel.app/orcid-callback
